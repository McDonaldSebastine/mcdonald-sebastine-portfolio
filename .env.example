# Copy this file to .env.local and fill in the values you need.

# Used to wire up the contact form (app/api/contact/route.ts) to a real
# email provider. Example shown for Resend (https://resend.com):
# RESEND_API_KEY=

# Optional: override the canonical site URL used in metadata/sitemap
# (defaults to the value in lib/site.ts)
# NEXT_PUBLIC_SITE_URL=https://mcdonaldsebastine.com
