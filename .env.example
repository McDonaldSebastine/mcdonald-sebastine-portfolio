# Copy this file to .env.local (locally) or add these under your host's
# environment variables settings (e.g. Vercel → Project Settings →
# Environment Variables) and fill in the values you need.

# Required to actually send contact-form emails. Get a free key at
# https://resend.com/api-keys — without this, submissions are just logged
# to the server console instead of emailed (see app/api/contact/route.ts).
RESEND_API_KEY=

# Optional: where submissions get sent. Defaults to the email in lib/site.ts
# if not set.
# CONTACT_RECIPIENT_EMAIL=sabastinemc@gmail.com

# Optional: the "from" address emails are sent from. Must be on a domain
# you've verified in Resend. Defaults to Resend's shared test address,
# which works immediately but is best for testing only — see the README's
# "Contact form" section for how to verify your own domain.
# CONTACT_FROM_EMAIL=portfolio@mcdonaldsebastine.com

# Optional: override the canonical site URL used in metadata/sitemap
# (defaults to the value in lib/site.ts)
# NEXT_PUBLIC_SITE_URL=https://mcdonaldsebastine.com
